<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>UAI.LiteRTLM</AssemblyName>

		<TargetFrameworks>net10.0;net8.0;net6.0</TargetFrameworks>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>

		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<ProjectRoot>$(MSBuildThisFileDirectory)../..</ProjectRoot>
		<ScriptsDir>$(ProjectRoot)/UAI.LiteRTLM/Packages/com.uralstech.uai.litertlm/Runtime/Scripts</ScriptsDir>
		<PluginsDir>$(ProjectRoot)/UAI.LiteRTLM/Packages/com.uralstech.uai.litertlm/Runtime/Plugins</PluginsDir>
		<ExternalLinkDir>External</ExternalLinkDir>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Uralstech.UAI.LiteRTLM</PackageId>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

		<Title>LiteRT-LM bindings for cross-platform .NET apps.</Title>
		<Description>Bindings for the cross-platform LiteRT-LM C API for .NET apps.</Description>
		<PackageTags>LiteRT-LM;AI;LiteRT;LLM</PackageTags>

		<Authors>Udayshankar Ravikumar</Authors>
		<Company>URAV ADVANCED LEARNING SYSTEMS PRIVATE LIMITED</Company>
		<Copyright>Copyright 2026 URAV ADVANCED LEARNING SYSTEMS PRIVATE LIMITED</Copyright>

		<PackageProjectUrl>https://uralstech.github.io/UAI.LiteRTLM</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Uralstech/UAI.LiteRTLM</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<PackageReleaseNotes>See https://github.com/Uralstech/UAI.LiteRTLM/releases/tag/$(Version)</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile
		  Include="$(ScriptsDir)/**/*.cs"
		  Exclude="$(ScriptsDir)/**/PackageUnsafeUtils.cs;$(ScriptsDir)/**/PackageLogger.cs;$(ScriptsDir)/**/IsExternalInit.cs">
			<Link>$(ExternalLinkDir)/Scripts/%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Compile>

		<None
		  Include="$(PluginsDir)/macOS/arm64/*.dylib"
		  Pack="true"
		  PackagePath="runtimes/osx-arm64/native/">
			<Link>$(ExternalLinkDir)/Native/osx-arm64/%(Filename)%(Extension)</Link>
		</None>

		<None
		  Include="$(PluginsDir)/Windows/x86_64/*.dll"
		  Pack="true"
		  PackagePath="runtimes/win-x64/native/">
			<Link>$(ExternalLinkDir)/Native/win-x64/%(Filename)%(Extension)</Link>
		</None>

		<None
		  Include="$(PluginsDir)/Android/arm64/*.so"
		  Pack="true"
		  PackagePath="runtimes/android-arm64/native/">
			<Link>$(ExternalLinkDir)/Native/android-arm64/%(Filename)%(Extension)</Link>
		</None>

		<None
		  Include="$(PluginsDir)/iOS/*.xcframework/**/*"
		  Pack="true"
		  PackagePath="runtimes/ios/native/%(RecursiveDir)%(Filename)%(Extension)">
			<Link>$(ExternalLinkDir)/Native/ios/%(RecursiveDir)%(Filename)%(Extension)</Link>
		</None>

        <None
          Include="buildTransitive\Uralstech.UAI.LiteRTLM.targets"
          Pack="true"
          PackagePath="buildTransitive/" />

		<None
		  Include="$(PluginsDir)/.build_sources.arm64.txt"
		  Pack="true"
		  PackagePath="">
			<Link>$(ExternalLinkDir)/Native/%(Filename)%(Extension)</Link>
		</None>

		<None
		  Include="$(PluginsDir)/.build_sources.windows_x64.txt"
		  Pack="true"
		  PackagePath="">
			<Link>$(ExternalLinkDir)/Native/%(Filename)%(Extension)</Link>
		</None>

		<None
		  Include="$(ProjectRoot)/THIRD-PARTY-LICENSES.md"
		  Pack="true"
		  PackagePath="">
			<Link>$(ExternalLinkDir)/%(Filename)%(Extension)</Link>
		</None>

		<None
		  Include="README.md"
		  Pack="true"
		  PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<None
		  Condition="$([MSBuild]::IsOSPlatform('OSX'))"
		  Include="$(PluginsDir)/macOS/arm64/*.dylib"
		  Pack="false">
			<Link>$(ExternalLinkDir)/Native/Dev/%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>%(Filename)%(Extension)</TargetPath>
		</None>

		<None
		  Condition="$([MSBuild]::IsOSPlatform('Windows'))"
		  Include="$(PluginsDir)/Windows/x86_64/*.dll"
		  Pack="false">
			<Link>$(ExternalLinkDir)/Native/Dev/%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>%(Filename)%(Extension)</TargetPath>
		</None>
	</ItemGroup>
</Project>